# Brave Search (required)
BRAVE_SEARCH_API_KEY=

# Local Qwen reasoning proxy (required)
QWEN_API_KEY=
QWEN_BASE_URL=http://127.0.0.1:8081/v1
QWEN_MODEL=qwen3.8-off

# Gmail SMTP (for digest email)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_DEFAULT_TO=

